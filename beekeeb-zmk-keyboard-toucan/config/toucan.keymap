#include <behaviors.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define SYM   1
#define NAV   2
#define MOUSE 3
#define FN    4
#define ADJ   5
#define BOOT  6
#define SCROLL 7

#define HRM_TAPPING_TERM 145
#define HRM_SHIFT_TAPPING_TERM 115
#define HRM_QUICK_TAP 0
#define HRM_REQUIRE_PRIOR_IDLE 135
#define HRM_SHIFT_REQUIRE_PRIOR_IDLE 120
#define LAYER_TAPPING_TERM 145
#define LAYER_TAB_TAPPING_TERM 220
#define LAYER_SPACE_TAPPING_TERM 160
#define LAYER_QUICK_TAP 0
#define LAYER_BACKSPACE_QUICK_TAP 120
#define COMBO_REQUIRE_PRIOR_IDLE 150

#define LEFT_HAND_KEYS  1  2  3  4  5 13 14 15 16 17 25 26 27 28 29
#define RIGHT_HAND_KEYS 6  7  8  9 10 18 19 20 21 22 30 31 32 33 34
#define LEFT_THUMB_KEYS 36 37 38
#define RIGHT_THUMB_KEYS 39 40 41
/* Same-hand exceptions: positions a home-row mod is still allowed to hold for. */
#define LEFT_Z_KEY 25
#define LEFT_TAB_THUMB_KEY 38
#define RIGHT_N_KEY 30
#define RIGHT_DOT_KEY 33
#define RIGHT_SAME_HAND_KEYS RIGHT_N_KEY RIGHT_DOT_KEY
#define HYPER(k) LC(LA(LS(LG(k))))

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <LAYER_TAPPING_TERM>;
    quick-tap-ms = <LAYER_QUICK_TAP>;
};

/ {
    macros {
        hm: hyper_mods {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>
                ;
        };

        adj_hold: adjust_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo SYM &mo NAV>
                , <&macro_pause_for_release>
                , <&macro_release &mo NAV &mo SYM>
                ;
        };

        cmd_shift_space: command_shift_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <20>;
            bindings
                = <&macro_tap &sk_lazy LGUI &sk_lazy LSHFT &kp SPACE>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";

        hyper_thumb {
            timeout-ms = <50>;
            require-prior-idle-ms = <COMBO_REQUIRE_PRIOR_IDLE>;
            key-positions = <40 41>;
            layers = <BASE>;
            slow-release;
            bindings = <&hm>;
        };

    };

    behaviors {
        sk_lazy: sticky_key_lazy {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            lazy;
            ignore-modifiers;
            display-name = "Lazy Sticky Key";
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS RIGHT_THUMB_KEYS LEFT_Z_KEY LEFT_TAB_THUMB_KEY>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS LEFT_THUMB_KEYS RIGHT_SAME_HAND_KEYS>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right";
        };

        hmls: home_row_mod_left_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_SHIFT_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_SHIFT_REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS RIGHT_THUMB_KEYS LEFT_Z_KEY LEFT_TAB_THUMB_KEY>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Left Shift";
        };

        hmrs: home_row_mod_right_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_SHIFT_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_SHIFT_REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS LEFT_THUMB_KEYS RIGHT_SAME_HAND_KEYS>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right Shift";
        };

        ltb: layer_tap_backspace {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <LAYER_TAPPING_TERM>;
            quick-tap-ms = <LAYER_BACKSPACE_QUICK_TAP>;
            hold-while-undecided;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap Backspace";
        };

        adjt: adjust_tap_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <LAYER_TAB_TAPPING_TERM>;
            quick-tap-ms = <LAYER_QUICK_TAP>;
            hold-while-undecided;
            bindings = <&adj_hold>, <&kp>;
            display-name = "Adjust-Tap Tab";
        };

        lts: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <LAYER_SPACE_TAPPING_TERM>;
            quick-tap-ms = <LAYER_QUICK_TAP>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap Space";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none &kp Q           &kp W        &kp E        &kp R         &kp T     &kp Y     &kp U         &kp I          &kp O        &kp P           &none
                &none &hml LCTRL A    &hml LALT S  &hml LGUI D  &hmls LSHFT F &kp G     &kp H     &hmrs RSHFT J &hmr RGUI K    &hmr RALT L  &hmr RCTRL SEMI &none
                &none &kp Z           &kp X        &kp C        &kp V         &kp B     &kp N     &kp M         &kp COMMA      &kp DOT      &kp FSLH        &none
                                      &lt SYM ESC  &ltb NAV BSPC &adjt 0 TAB   &lt NAV RET &lts SYM SPACE &lt FN SQT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none &kp LBRC  &kp SQT   &kp DQT   &kp RBRC  &kp QMARK   &kp LPAR  &kp HYPER(N7)  &kp HYPER(N8)  &kp HYPER(N9)  &kp GRAVE &none
                &none &kp CARET &kp EQUAL &kp MINUS &kp DLLR  &kp STAR    &kp RPAR  &kp HYPER(N4)  &kp HYPER(N5)  &kp HYPER(N6)  &kp PRCNT &none
                &none &kp LT    &kp PIPE  &kp UNDER &kp GT    &kp TILDE   &kp HASH  &kp HYPER(N1)  &kp HYPER(N2)  &kp HYPER(N3)  &kp BSLH  &none
                                      &kp EXCL  &kp AT    &kp COLON   &kp LBKT &kp RBKT &kp AMPS
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none &cmd_shift_space &kp LS(LG(Z)) &kp LG(Z)    &kp LG(A)  &kp LG(X)    &kp C_PP   &kp C_STOP &kp C_PREV &kp C_NEXT &none     &none
                &none &mkp MB3         &mkp MB2      &mkp MB1     &none       &kp LG(C)    &none      &kp LEFT   &kp UP     &kp DOWN   &kp RIGHT &none
                &none &mo SCROLL       &none         &none        &none       &kp LG(V)    &none      &kp HOME   &kp PG_UP  &kp PG_DN  &kp END   &none
                                           &mo MOUSE &kp C_BRI_DN &kp C_BRI_UP    &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
                &none &none      &none          &mmv MOVE_UP   &none            &none             &none      &none     &none     &none       &none     &none
                &none &none      &mmv MOVE_LEFT &mkp MB1       &mmv MOVE_RIGHT  &mkp MB2          &none      &mkp MB1  &mkp MB2  &mkp MB3    &none     &none
                &none &none      &msc SCRL_LEFT &mmv MOVE_DOWN &msc SCRL_RIGHT  &mkp MB3          &none      &none     &kp PG_UP &kp PG_DN   &none     &none
                                                &to BASE       &trans           &trans            &trans     &trans    &trans
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
                &none &none     &none     &none     &none   &none      &none  &kp F7  &kp F8  &kp F9  &kp F12 &none
                &none &none     &none     &none     &none   &none      &none  &kp F4  &kp F5  &kp F6  &kp F11 &none
                &none &none     &none     &none     &none   &none      &none  &kp F1  &kp F2  &kp F3  &kp F10 &none
                                      &none   &none   &none      &kp F14 &kp F15 &none
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &none &out OUT_USB    &out OUT_BLE &none        &none        &bt BT_CLR     &kp PLUS  &kp N7  &kp N8  &kp N9  &kp GRAVE &none
                &none &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp MINUS  &kp N4  &kp N5  &kp N6  &kp STAR  &none
                &none &studio_unlock  &caps_word   &none        &mo BOOT     &none          &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp FSLH  &none
                                             &none       &none        &none        &kp DOT &kp N0 &kp KP_ENTER
            >;
        };

        boot {
            display-name = "BOOT";
            bindings = <
                &none &none   &none        &bootloader &sys_reset &none    &bootloader &none &none &none &sys_reset &none
                &none &none   &none        &none       &none       &none    &none       &none &none &none &none      &none
                &none &none   &none        &none       &none       &none    &none       &none &none &none &none      &none
                                    &none       &mo SCROLL  &none    &none &none &none
            >;
        };

        scroll {
            display-name = "SCROLL";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                                      &trans &trans &trans    &trans &trans &trans
            >;
        };

        extra_3 {
            status = "reserved";
        };
    };
};
