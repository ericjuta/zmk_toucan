#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define SYM   1
#define NAV   2
#define ADJ   3
#define MOUSE 4
#define FN    5

/ {
    macros {
        hm: hyper_mods {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp RCTRL &kp RSHFT &kp RALT &kp RGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp RCTRL &kp RSHFT &kp RALT &kp RGUI>
                ;
        };
    };

    behaviors {
        hsp: hyper_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&hm>, <&kp>;
            display-name = "Hyper Space";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none &kp Q           &kp W        &kp E        &kp R         &kp T     &kp Y     &kp U         &kp I          &kp O        &kp P           &none
                &none &mt LCTRL A     &mt LALT S   &mt LGUI D   &mt LSHFT F   &kp G     &kp H     &mt RSHFT J   &mt RGUI K     &mt RALT L   &mt RCTRL SEMI  &none
                &none &kp Z           &kp X        &kp C        &kp V         &kp B     &kp N     &kp M         &kp COMMA      &kp DOT      &kp FSLH        &none
                                      &lt SYM ESC  &lt NAV BSPC &lt ADJ TAB   &lt NAV RET &hsp 0 SPACE &lt FN SQT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none &kp LBRC  &kp SQT   &kp DQT   &kp RBRC  &kp QMARK   &kp LPAR  &kp N7  &kp N8  &kp N9  &kp GRAVE &none
                &none &kp CARET &kp EQUAL &kp MINUS &kp DLLR  &kp STAR    &kp RPAR  &kp N4  &kp N5  &kp N6  &kp SQT   &none
                &none &kp LT    &kp PIPE  &kp UNDER &kp GT    &kp FSLH    &kp HASH  &kp N1  &kp N2  &kp N3  &kp QMARK &none
                                      &kp EXCL  &kp AT    &kp PLUS    &kp LBKT &kp RBKT &kp AMPS
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none &none       &kp LS(LG(Z)) &kp LG(Z)    &kp LG(A)  &kp LG(X)    &kp C_PP   &kp C_STOP &kp C_PREV &kp C_NEXT &none     &none
                &none &kp LG(SPC) &mkp MB2      &mkp MB1     &kp LG(C)  &kp LG(V)    &none      &kp LEFT   &kp UP     &kp DOWN   &kp RIGHT &none
                &none &mkp MB3    &none         &mkp MB3     &none      &none        &none      &kp HOME   &kp PG_UP  &kp PG_DN  &kp END   &none
                                           &mo MOUSE &kp C_BRI_DN &kp C_BRI_UP    &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &none &none           &none        &none        &none        &bt BT_CLR     &none      &kp N7  &kp N8  &kp N9  &none    &none
                &none &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp MINUS  &kp N4  &kp N5  &kp N6  &kp STAR  &none
                &none &studio_unlock  &none        &none        &none        &none          &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp FSLH  &none
                                             &none       &none        &none        &kp DOT &kp N0 &kp RPAR
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
                &none &none      &none          &mmv MOVE_UP   &none            &none             &none      &none     &none     &none       &none     &none
                &none &none      &mmv MOVE_LEFT &mkp MB1       &mmv MOVE_RIGHT  &mkp MB2          &none      &mkp MB1  &mkp MB2  &mkp MB3    &mo ADJ   &none
                &none &none      &msc SCRL_LEFT &mmv MOVE_DOWN &msc SCRL_RIGHT  &mkp MB3          &none      &none     &kp PG_UP &kp PG_DN   &none     &none
                                                &to BASE       &trans           &trans            &trans     &trans    &trans
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
                &none &none   &none   &none   &none   &none      &none  &kp F7  &kp F8  &kp F9  &kp F12 &none
                &none &none   &none   &none   &none   &none      &none  &kp F4  &kp F5  &kp F6  &kp F11 &none
                &none &none   &none   &none   &none   &none      &none  &kp F1  &kp F2  &kp F3  &kp F10 &none
                                      &none   &none   &none      &kp F14 &kp F15 &none
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
