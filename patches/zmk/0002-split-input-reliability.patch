@@ -312,21 +312,76 @@ static int zmk_split_bt_sensor_triggered(uint8_t sensor_index,
 
 #if IS_ENABLED(CONFIG_ZMK_INPUT_SPLIT)
 
+struct input_notify_item {
+    const struct bt_gatt_attr *attr;
+    struct zmk_split_input_event_payload payload;
+};
+
+K_MSGQ_DEFINE(input_event_msgq, sizeof(struct input_notify_item),
+              CONFIG_ZMK_SPLIT_BLE_PERIPHERAL_INPUT_QUEUE_SIZE, 4);
+
+static void send_input_report_callback(struct k_work *work) {
+    struct input_notify_item item;
+
+    while (k_msgq_peek(&input_event_msgq, &item) == 0) {
+        int err = bt_gatt_notify(NULL, item.attr, &item.payload, sizeof(item.payload));
+        if (err == -ENOMEM || err == -EAGAIN) {
+            LOG_DBG("Input notify deferred (%d)", err);
+            int reschedule_err = k_work_reschedule_for_queue(
+                &service_work_q, k_work_delayable_from_work(work), K_MSEC(1));
+            if (reschedule_err < 0) {
+                LOG_ERR("Failed to reschedule input notification (%d)", reschedule_err);
+            }
+            return;
+        }
+
+        /* Remove only after success or a non-transient terminal error. */
+        int dequeue_err = k_msgq_get(&input_event_msgq, &item, K_NO_WAIT);
+        if (dequeue_err) {
+            LOG_ERR("Failed to dequeue sent input event (%d)", dequeue_err);
+            return;
+        }
+
+        if (err) {
+            LOG_WRN("Input notification failed (%d)", err);
+        }
+    }
+}
+
+static K_WORK_DELAYABLE_DEFINE(service_input_notify_work, send_input_report_callback);
