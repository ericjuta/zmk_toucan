+    137, 143, 150, 158, 166, 175, 185, 196, 209, 223, 238,
+};
+
+static uint8_t tps43_angle_deg_to_reg(int16_t degrees) {
+  if (degrees < 0) {
+    degrees = 0;
+  } else if (degrees >= (int16_t)ARRAY_SIZE(tps43_angle_reg_lut)) {
+    degrees = (int16_t)ARRAY_SIZE(tps43_angle_reg_lut) - 1;
+  }
+
+  return tps43_angle_reg_lut[degrees];
+}
